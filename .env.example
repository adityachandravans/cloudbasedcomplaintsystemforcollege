# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Base URL
CLIENT_URL=http://localhost:3000

# Database Configuration (Leave empty or set 'memory' to use embedded MongoMemoryServer for instant execution, or enter MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/college_complaint_db?retryWrites=true&w=majority

# Authentication
JWT_SECRET=college_complaint_jwt_super_secret_key_2026

# Cloud Storage Configuration (Optional - standard local disk storage fallback is enabled out of the box)
CLOUD_STORAGE_URL=https://res.cloudinary.com/your-cloud-name/raw/upload
CLOUD_STORAGE_KEY=your_cloud_key
CLOUD_STORAGE_SECRET=your_cloud_secret
